<!DOCTYPE html>
<html>
  <head>
    <title>phlex-reactive dummy</title>
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <%= csrf_meta_tags %>

    <style>
      /* Dirty tracking (issue #103): the badge is hidden until the reactive root
         carries data-reactive-dirty (the count from #scanDirty) — pure CSS, no
         Ruby toggles it. Mirrors how apps style [data-reactive-busy] spinners. */
      .unsaved-badge { display: none; }
      [data-reactive-dirty] .unsaved-badge { display: inline; }
    </style>

    <script type="importmap">
      {
        "imports": {
          <%# Issue #187: pin turbo to a shim that re-exports a NAMED `Turbo`
              (the raw turbo.js only sets window.Turbo). pgbus's stream-source
              client does `import { Turbo } from "@hotwired/turbo-rails"`; without
              the named export its module throws and the SSE element never
              registers. The shim re-runs turbo.js's side effects, so a bare
              `import "@hotwired/turbo-rails"` (the cable cells) is unaffected. %>
          "@hotwired/turbo-rails": "/vendor/turbo_rails_shim.js",
          "@hotwired/stimulus": "/vendor/stimulus.js",
          <%# Issue #275: the DEFAULT client is one file with every feature
              bundled in. REACTIVE_CLIENT=split loads the opt-in core instead,
              which imports the feature pins below on demand. %>
          "reactive_controller": "<%= ENV["REACTIVE_CLIENT"] == "split" ? "/vendor/core.js" : "/vendor/reactive_controller.js" %>",
          "phlex/reactive/confirm": "/vendor/confirm.js",
          <%# Issue #275: every feature module, pinned as the engine pins them.
              ?slow=<ms> serves ONE of them late — the persist module on
              /persist_action, or the one ?slow_feature=<name> names — which
              opens the window between the controller connecting and that
              feature arriving. %>
          <% slow_ms = @slow_feature_ms || (params[:slow_feature].present? ? params[:slow].to_i.clamp(0, 5000) : nil) %>
          <% slow_name = params[:slow_feature].presence || "persist" %>
          <% Phlex::Reactive::Engine::CLIENT_FEATURES.each do |name| %>
          "phlex/reactive/features/<%= name %>": "<%= slow_ms && slow_name == name ? "/slow_feature/#{name}.js?ms=#{slow_ms}" : "/vendor/features/#{name}.js" %>",
          <% end %>
          "phlex/reactive/confirm_predicate": "/vendor/confirm_predicate.js",
          "phlex/reactive/compute": "/vendor/compute.js",
          "phlex/reactive/inspect": "/vendor/inspect.js",
          "payment_split_reducer": "/vendor/payment_split_reducer.js",
          "post_preview_reducer": "/vendor/post_preview_reducer.js",
          "compute_seed_reducer": "/vendor/compute_seed_reducer.js",
          "compute_checked_reducer": "/vendor/compute_checked_reducer.js",
          "otp_reducer": "/vendor/otp_reducer.js",
          "split_code_reducer": "/vendor/split_code_reducer.js",
          "confirm_predicate_registration": "/vendor/confirm_predicate_registration.js",
          <%# Issue #241: the REAL rich editors (Trix 2.1.19 from action_text-trix,
              Lexxy 0.9.31 — both MIT). Pinned only; the persist_editors demo
              imports them itself so no other page pays for the ~1.5 MB. %>
          "trix": "/vendor/trix.js",
          "lexxy": "/vendor/lexxy.js"<% if ENV["TRANSPORT"] == "pgbus" %>,
          <%# Issue #187: pgbus's turbo_stream_from injects `import
              "pgbus/stream_source_element"`; pin it to the vendored engine asset
              (this app has no asset pipeline / importmap-rails auto-pin). %>
          "pgbus/stream_source_element": "/vendor/pgbus_stream_source_element.js"<% end %>
        }
      }
    </script>

    <script type="module">
      import "@hotwired/turbo-rails"
      import { Application } from "@hotwired/stimulus"
      import ReactiveController from "reactive_controller"
      import { registerPaymentSplit } from "payment_split_reducer"
      import { registerPostPreview } from "post_preview_reducer"
      import { registerComputeSeed } from "compute_seed_reducer"
      import { registerComputeChecked } from "compute_checked_reducer"
      import { registerOtp } from "otp_reducer"
      import { registerSplitCode } from "split_code_reducer"
      import { registerConfirmPredicates } from "confirm_predicate_registration"

      const application = Application.start()
      // Register eagerly so a click right after load is never missed.
      application.register("reactive", ReactiveController)
      window.Stimulus = application

      // Register the demo's client-side compute reducers (the JS twins of the Ruby
      // PaymentSplit and the issue #104 typed-preview counter). The OrderComponent's
      // new-draft path runs payment_split; PostPreviewComponent runs preview.
      registerPaymentSplit()
      registerPostPreview()
      registerComputeSeed()
      registerComputeChecked() // issue #262: checkbox/radio compute inputs + outputs
      registerOtp() // issue #226: the $ops auto-commit flagship
      registerSplitCode() // issue #226: the multi-box variant
      registerConfirmPredicates()
    </script>
  </head>
  <body>
    <div id="flash"></div> <%# Response#flash appends here (Phlex::Reactive.flash_target) %>
    <%= yield %>
  </body>
</html>
